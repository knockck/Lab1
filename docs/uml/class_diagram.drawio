  <diagram id="Часть_1._Архитектура" name="Часть 1. Архитектура">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title1" value="Часть 1. Архитектура приложения (слои и зависимости)" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="700" height="30" as="geometry" />
        </mxCell>
        <mxCell id="pkg2" value="&lt;b&gt;main.py — точка входа (консольное приложение)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;ConsoleApp — 21 действие меню, ввод/вывод, обработка исключений&lt;br&gt;build_app() — создаёт репозитории и передаёт их в сервисы&lt;/span&gt;" style="shape=folder;fontStyle=0;tabWidth=110;tabHeight=18;tabPosition=left;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=20;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="260" y="60" width="520" height="90" as="geometry" />
        </mxCell>
        <mxCell id="pkg3" value="&lt;b&gt;service_layer — бизнес-логика&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;DrawingService — рисунок, статистика, файлы JSON/XML, отмена&lt;br&gt;LayerService — слои: создание, блокировка, порядок, удаление&lt;br&gt;ShapeService — фигуры: изменение, копирование, поиск, z-порядок&lt;br&gt;HistoryService — снимки состояния, отмена, откат при ошибке&lt;br&gt;ShapeFactory — создание фигур по типу и параметрам&lt;/span&gt;" style="shape=folder;fontStyle=0;tabWidth=110;tabHeight=18;tabPosition=left;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=20;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="260" y="210" width="520" height="140" as="geometry" />
        </mxCell>
        <mxCell id="pkg4" value="&lt;b&gt;repository_layer — CRUD-операции над сущностями&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;«interface» Repository[K, E] — add, get, get_all, update, delete&lt;br&gt;«interface» ShapeRepository, LayerRepository, CanvasRepository&lt;br&gt;InMemoryShapeRepository, InMemoryLayerRepository,&lt;br&gt;InMemoryCanvasRepository — хранение в словарях (Map) в памяти&lt;br&gt;DrawingStorage, JsonDrawingStorage, XmlDrawingStorage — файлы&lt;/span&gt;" style="shape=folder;fontStyle=0;tabWidth=110;tabHeight=18;tabPosition=left;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=20;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="260" y="410" width="520" height="130" as="geometry" />
        </mxCell>
        <mxCell id="pkg5" value="&lt;b&gt;data_layer — сущности&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Point, Color, Style — примитивы&lt;br&gt;Shape (abstract): Rectangle, Ellipse, Circle, Line, Polygon, TextLabel&lt;br&gt;Layer — слой, Canvas — холст, Drawing — снимок рисунка&lt;/span&gt;" style="shape=folder;fontStyle=0;tabWidth=110;tabHeight=18;tabPosition=left;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=20;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
